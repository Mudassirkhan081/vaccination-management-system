digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=0.9, newrank=true, pad=0.3, bgcolor="white", fontname="Helvetica"];
  node  [shape=plaintext, fontname="Helvetica", fontsize=10];
  edge  [fontname="Helvetica", fontsize=9, color="#4F5F58", penwidth=1.2, dir=both];

  parents [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9DB3A8">
    <TR><TD COLSPAN="3" BGCOLOR="#16503F"><FONT COLOR="white"><B>parents</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#E7F0EB"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="id" ALIGN="LEFT">INT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
    <TR><TD>UQ</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">cnic</TD><TD ALIGN="LEFT">VARCHAR(15)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">city, address</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">created_at, updated_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
   </TABLE>>];

  children [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9DB3A8">
    <TR><TD COLSPAN="3" BGCOLOR="#16503F"><FONT COLOR="white"><B>children</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#E7F0EB"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="id" ALIGN="LEFT">INT</TD></TR>
    <TR><TD PORT="parent" BGCOLOR="#EEEBFA">FK</TD><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="LEFT">INT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">date_of_birth</TD><TD ALIGN="LEFT">DATE</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">gender</TD><TD ALIGN="LEFT">ENUM</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">blood_group</TD><TD ALIGN="LEFT">VARCHAR(5)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">birth_weight</TD><TD ALIGN="LEFT">DECIMAL(4,2)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
   </TABLE>>];

  hospitals [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9DB3A8">
    <TR><TD COLSPAN="3" BGCOLOR="#16503F"><FONT COLOR="white"><B>hospitals</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#E7F0EB"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="id" ALIGN="LEFT">INT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR>
    <TR><TD>UQ</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">phone, city</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">address, location</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">timings</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM</TD></TR>
   </TABLE>>];

  appointments [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9DB3A8">
    <TR><TD COLSPAN="3" BGCOLOR="#16503F"><FONT COLOR="white"><B>appointments</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#E7F0EB"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="id" ALIGN="LEFT">INT</TD></TR>
    <TR><TD PORT="parent" BGCOLOR="#EEEBFA">FK</TD><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="LEFT">INT</TD></TR>
    <TR><TD PORT="child" BGCOLOR="#EEEBFA">FK</TD><TD ALIGN="LEFT">child_id</TD><TD ALIGN="LEFT">INT</TD></TR>
    <TR><TD PORT="hospital" BGCOLOR="#EEEBFA">FK</TD><TD ALIGN="LEFT">hospital_id</TD><TD ALIGN="LEFT">INT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">appointment_date / time</TD><TD ALIGN="LEFT">DATE / TIME</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">parent_note</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">request_status</TD><TD ALIGN="LEFT">ENUM</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">admin_remark, decided_at</TD><TD ALIGN="LEFT">VARCHAR / DATETIME</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">vaccination_status</TD><TD ALIGN="LEFT">ENUM</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">hospital_remark, completed_at</TD><TD ALIGN="LEFT">VARCHAR / DATETIME</TD></TR>
   </TABLE>>];

  vaccines [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9DB3A8">
    <TR><TD COLSPAN="3" BGCOLOR="#16503F"><FONT COLOR="white"><B>vaccines</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#E7F0EB"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="id" ALIGN="LEFT">INT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
    <TR><TD>UQ</TD><TD ALIGN="LEFT">short_name</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">protects_against</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">age_days, age_label</TD><TD ALIGN="LEFT">INT / VARCHAR</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">route, description</TD><TD ALIGN="LEFT">VARCHAR / TEXT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM</TD></TR>
   </TABLE>>];

  appointment_vaccines [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9DB3A8">
    <TR><TD COLSPAN="3" BGCOLOR="#4A3AA8"><FONT COLOR="white"><B>appointment_vaccines</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#E7F0EB"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="id" ALIGN="LEFT">INT</TD></TR>
    <TR><TD PORT="appt" BGCOLOR="#EEEBFA">FK</TD><TD ALIGN="LEFT">appointment_id</TD><TD ALIGN="LEFT">INT</TD></TR>
    <TR><TD PORT="vaccine" BGCOLOR="#EEEBFA">FK</TD><TD ALIGN="LEFT">vaccine_id</TD><TD ALIGN="LEFT">INT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">ENUM</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">given_at</TD><TD ALIGN="LEFT">DATETIME</TD></TR>
   </TABLE>>];

  vaccination_history [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9DB3A8">
    <TR><TD COLSPAN="3" BGCOLOR="#4A3AA8"><FONT COLOR="white"><B>vaccination_history</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#E7F0EB"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="id" ALIGN="LEFT">INT</TD></TR>
    <TR><TD PORT="child" BGCOLOR="#EEEBFA">FK</TD><TD ALIGN="LEFT">child_id</TD><TD ALIGN="LEFT">INT</TD></TR>
    <TR><TD PORT="vaccine" BGCOLOR="#EEEBFA">FK</TD><TD ALIGN="LEFT">vaccine_id</TD><TD ALIGN="LEFT">INT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">given_on</TD><TD ALIGN="LEFT">DATE</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">place</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR>
   </TABLE>>];

  admins [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9DB3A8">
    <TR><TD COLSPAN="3" BGCOLOR="#16503F"><FONT COLOR="white"><B>admins</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#E7F0EB"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="id" ALIGN="LEFT">INT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">VARCHAR(100)</TD></TR>
    <TR><TD>UQ</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(150)</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
   </TABLE>>];

  notifications [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9DB3A8">
    <TR><TD COLSPAN="3" BGCOLOR="#8F5405"><FONT COLOR="white"><B>notifications</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#E7F0EB"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD PORT="id" ALIGN="LEFT">INT</TD></TR>
    <TR><TD PORT="owner" BGCOLOR="#FBEFD9">*</TD><TD ALIGN="LEFT">user_role + user_id</TD><TD ALIGN="LEFT">ENUM + INT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">title, message, link</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">is_read</TD><TD ALIGN="LEFT">TINYINT(1)</TD></TR>
   </TABLE>>];

  contact_messages [label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#9DB3A8">
    <TR><TD COLSPAN="3" BGCOLOR="#8F5405"><FONT COLOR="white"><B>contact_messages</B></FONT></TD></TR>
    <TR><TD BGCOLOR="#E7F0EB"><B>PK</B></TD><TD ALIGN="LEFT"><B>id</B></TD><TD ALIGN="LEFT">INT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">name, email, subject</TD><TD ALIGN="LEFT">VARCHAR</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">message</TD><TD ALIGN="LEFT">TEXT</TD></TR>
    <TR><TD></TD><TD ALIGN="LEFT">is_read</TD><TD ALIGN="LEFT">TINYINT(1)</TD></TR>
   </TABLE>>];

  { rank=same; parents; hospitals; admins; contact_messages; }
  { rank=same; children; vaccines; notifications; }
  { rank=same; appointments; vaccination_history; }

  /* Crow's foot notation: "teetee" = exactly one, "crowodot" = zero or many, "crowtee" = one or many */
  parents:id:e   -> children:parent:w       [arrowtail=teetee, arrowhead=crowodot, label="has"];
  parents:id:e   -> appointments:parent:w   [arrowtail=teetee, arrowhead=crowodot, label="requests"];
  children:id:e  -> appointments:child:w    [arrowtail=teetee, arrowhead=crowodot, label="is booked in"];
  hospitals:id:e -> appointments:hospital:w [arrowtail=teetee, arrowhead=crowodot, label="hosts"];
  appointments:id:e -> appointment_vaccines:appt:w [arrowtail=teetee, arrowhead=crowtee, label="includes"];
  vaccines:id:e  -> appointment_vaccines:vaccine:w [arrowtail=teetee, arrowhead=crowodot, label="given in"];
  children:id:e  -> vaccination_history:child:w    [arrowtail=teetee, arrowhead=crowodot, label="paper-card doses"];
  vaccines:id:e  -> vaccination_history:vaccine:w  [arrowtail=teetee, arrowhead=crowodot, label="recorded as"];
  admins:id:e    -> notifications:owner:w [style=dashed, arrowtail=teetee, arrowhead=crowodot, label="receive", color="#8F5405", fontcolor="#8F5405"];
  parents:id:e   -> notifications:owner:w [style=dashed, arrowtail=teetee, arrowhead=crowodot, color="#8F5405"];
  hospitals:id:e -> notifications:owner:w [style=dashed, arrowtail=teetee, arrowhead=crowodot, color="#8F5405"];
  contact_messages -> admins [style=invis];
}
